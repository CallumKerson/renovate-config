{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "schedule:weekly",
    ":semanticCommits",
    ":automergeStableNonMajor",
    ":automergeDigest",
    ":prHourlyLimit4",
    "customManagers:dockerfileVersions",
    "customManagers:githubActionsVersions"
  ],
  "reviewers": ["CallumKerson"],
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "1 week",
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Lock file maintenance and pins change no version ranges, so merge them once CI passes",
      "matchUpdateTypes": ["lockFileMaintenance", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "description": "Digests track a moving tag or branch, so take them sooner",
      "matchUpdateTypes": ["digest"],
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "Workflow and action updates only affect CI",
      "matchFileNames": [".github/**"],
      "semanticCommitType": "ci"
    },
    {
      "description": "Mise tools only affect the build, so updating them must not cut a release",
      "matchManagers": ["mise"],
      "semanticCommitType": "build"
    },
    {
      "description": "New versions of this preset are my own changes, so take them straight away. They only change dependency config, so must not cut a release",
      "matchManagers": ["renovate-config"],
      "matchDepNames": ["CallumKerson/renovate-config"],
      "minimumReleaseAge": null,
      "semanticCommitType": "build"
    }
  ]
}
